# ==========================================
# 3. SOLIDWORKS CAD-FILER
# ==========================================
# Ignorerer store 3D-modeller og samlinger (anbefales å lagres i f.eks. GrabCAD/Drive i stedet for Git)
*.sldprt
*.sldasm
*.slddrw

# SolidWorks midlertidige filer og sikkerhetskopier (åpne filer starter ofte med ~$ )
~$*.sldprt
~$*.sldasm
~$*.slddrw
*.bak
*.sldbak
*-[0-9].sldprt
*-[0-9].sldasm

# ==========================================
# 4. UTVIKLINGSVERKTØY (VS Code, JetBrains)
# ==========================================
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

